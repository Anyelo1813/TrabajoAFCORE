@page "/empleados"
@rendermode InteractiveServer
@inject IEmpleadoService EmpleadoService

<h3 class="d-flex justify-content-between align-items-center">
    Empleados
    <span @onclick="Agregar" class="btn btn-outline-success btn-lg fw-bold">+</span>
</h3>

@if (ShowForm)
{
    <div class="card shadow-lg mt-3">
        <div class="card-header bg-primary text-white">@Titulo</div>
        <div class="card-body">
            <div class="mt-3 form-group">
                <label class="form-label fw-bold">Nombre</label>
                <input class="form-control shadow-sm" type="text" @bind="Request.DatosPersonales.Nombre" />
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="mt-3 form-group">
                        <label class="form-label fw-bold">Fecha de Nacimiento</label>
                        <input class="form-control shadow-sm" type="date" @bind="Request.DatosPersonales.FechaDeNacimiento" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mt-3 form-group">
                        <label class="form-label fw-bold">Sueldo</label>
                        <input class="form-control shadow-sm" type="number" @bind="Request.Sueldo" />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
            <span @onclick="Add" class="btn btn-success shadow">Aceptar</span>
            <span @onclick="Clear" class="btn btn-danger shadow">Cancelar</span>
        </div>
    </div>
}
else
{
    <table class="table table-striped table-hover mt-4 shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Acciones</th>
                <th>Código</th>
                <th>Empleado</th>
                <th>Fecha de Nacimiento</th>
                <th>Sueldo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Listado)
            {
                <tr>
                    <td>
                        <div class="btn-group">
                            <span @onclick="()=>Modificar(item.Id)" class="btn btn-warning shadow-sm">Modificar</span>
                            <span @onclick="()=>Eliminar(item.Id)" class="btn btn-danger shadow-sm">Eliminar</span>
                        </div>
                    </td>
                    <td>@item.Id</td>
                    <td>@item.DatosPersonales.Nombre</td>
                    <td>@(item.DatosPersonales.FechaDeNacimiento?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                    <td>@item.Sueldo.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    public string Titulo { get; set; } = "";
    public EmpleadoDto Request { get; set; } = new();
    public List<EmpleadoDto> Listado { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await Consultar();
    }

    private async Task Consultar()
    {
        Listado = await EmpleadoService.Consultar("");
    }

    public bool ShowForm { get; set; } = false;

    private void Toggle()
    {
        ShowForm = !ShowForm;
        StateHasChanged();
    }

    private void Clear()
    {
        Request = new();
        Toggle();
    }

    private void Agregar()
    {
        Clear();
        Titulo = "Registrar Empleado";
        ShowForm = true;
        StateHasChanged();
    }

    private async Task Add()
    {
        var result = Request.Id == 0
            ? await EmpleadoService.Crear(Request)
            : await EmpleadoService.Modificar(Request);

        if (result)
        {
            await Consultar();
            Clear();
        }
    }

    private void Modificar(int Id)
    {
        Clear();
        Titulo = "Modificar";
        Request = Listado.FirstOrDefault(e => e.Id == Id) ?? new();
        ShowForm = true;
        StateHasChanged();
    }

    private async Task Eliminar(int Id)
    {
        var result = await EmpleadoService.Eliminar(Id);
        if (result)
        {
            await Consultar();
        }
    }
}

